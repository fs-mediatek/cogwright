[resource]
script = ExtResource("1")
id = &"armor_plate"
display_name = "Panzerung"
description = "Eine schwere Eisen-Brass-Platte am Fundament. Spendet bei Trigger 30 Schild für 8s auf den eigenen Turm."
flavor_text = "Vier Generationen haben diese Platte überlebt. Sie wird auch dich überleben."
rarity = 1
tags = Array[StringName]([&"defensive", &"heavy"])

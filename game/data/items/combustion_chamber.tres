[gd_resource type="Resource" script_class="Item" load_steps=5 format=3]

[ext_resource type="Script" path="res://data/Item.gd" id="1"]
[ext_resource type="Script" path="res://data/effects/TagBonusEffect.gd" id="2"]
[ext_resource type="Texture2D" path="res://assets/items/combustion_chamber.png" id="3"]

[sub_resource type="Resource" id="effect_tagbonus"]
script = ExtResource("2")
hook = 1
tag_filter = &""
bonus_tag = &"fire"
bonus_damage_percent = 25.0
duration_seconds = 6.0

[resource]
script = ExtResource("1")
id = &"combustion_chamber"
display_name = "Brennkammer"
description = "Verstärkt periodisch alle [fire]-Items im Turm um 25% Schaden für 6 Sekunden."
flavor_text = "Im Herzen der Werkstatt brennt ein Feuer, das nie erlischt. Es wartet nur darauf, gefüttert zu werden."
rarity = 1
tags = Array[StringName]([&"fire", &"mechanical", &"modifier"])
floor_affinity = Array[StringName]([&"workshop"])
cooldown_seconds = 3.0
effects = Array[ExtResource("2")]([SubResource("effect_tagbonus")])
icon = ExtResource("3")

[resource]
script = ExtResource("1")
id = &"pressure_gauge"
display_name = "Druckmesser"
description = "Verstärkt periodisch alle [pressure]-Items im Turm um 25% Schaden für 6 Sekunden."
flavor_text = "Die Nadel zittert, dann zuckt sie. Drei Generationen Schmiede wussten: wenn die Nadel zuckt, schlägt das Eisen härter."
rarity = 1
tags = Array[StringName]([&"mechanical", &"modifier", &"pressure"])
floor_affinity = Array[StringName]([&"workshop"])
cooldown_seconds = 3.0
effects = Array[ExtResource("2")]([SubResource("effect_tagbonus")])
icon = ExtResource("3")

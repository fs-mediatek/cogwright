[resource]
script = ExtResource("1")
id = &"ammo_belt"
display_name = "Munitionsband"
description = "Verkürzt die Cooldowns aller Items auf der Etage darüber um 30% für 4s — Munition ohne Pause."
flavor_text = "Glieder aus Brass, Hülsen wie Perlen. Wer das Band füttert, hat keine Zeit zum Atmen."
rarity = 2
tags = Array[StringName]([&"mechanical", &"sync", &"support"])
floor_affinity = Array[StringName]([&"workshop"])

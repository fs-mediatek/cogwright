[resource]
script = ExtResource("1")
id = &"stabilizer_brace"
display_name = "Stabilisator-Strebe"
description = "Verkürzt die Cooldowns aller Items auf der Etage darunter um 25% für 6s — stabilisierte Mechanik feuert ruhiger und schneller."
flavor_text = "Wer die Last verteilt, kann schneller schlagen."
rarity = 1
tags = Array[StringName]([&"mechanical", &"support"])
floor_affinity = Array[StringName]([&"workshop"])
cooldown_seconds = 3.0
effects = Array[ExtResource("2")]([SubResource("effect_boost")])
icon = ExtResource("3")

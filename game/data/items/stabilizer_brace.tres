[gd_resource type="Resource" script_class="Item" load_steps=4 format=3]

[ext_resource type="Script" path="res://data/Item.gd" id="1"]
[ext_resource type="Script" path="res://data/effects/BoostFloorEffect.gd" id="2"]
[ext_resource type="Texture2D" path="res://assets/items/stabilizer_brace.png" id="3"]

[sub_resource type="Resource" id="effect_boost"]
script = ExtResource("2")
hook = 1
tag_filter = &""
floor_offset = -1

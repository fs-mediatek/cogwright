[gd_resource type="Resource" script_class="Item" load_steps=5 format=3]

[ext_resource type="Script" path="res://data/Item.gd" id="1"]
[ext_resource type="Script" path="res://data/effects/BoostFloorEffect.gd" id="2"]
[ext_resource type="Texture2D" path="res://assets/items/wind_mill.png" id="3"]

[sub_resource type="Resource" id="effect_boost"]
script = ExtResource("2")
hook = 1
tag_filter = &""
floor_offset = -1
cooldown_reduction_percent = 30.0
duration_seconds = 5.0

[resource]
script = ExtResource("1")
id = &"wind_mill"
display_name = "Windrad"
description = "Bläst Frischluft auf die Etage darunter. Alle Items eine Etage tiefer feuern +30% schneller für 5s."
flavor_text = "Vier Flügel, ein Versprechen: kein Item rastet, solange das Windrad dreht."
rarity = 2
tags = Array[StringName]([&"mechanical", &"support", &"modifier"])
floor_affinity = Array[StringName]([&"pinnacle"])
cooldown_seconds = 6.0
effects = Array[ExtResource("2")]([SubResource("effect_boost")])
icon = ExtResource("3")

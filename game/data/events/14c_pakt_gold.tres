[gd_resource type="Resource" script_class="EventConfig" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/EventConfig.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"pakt_gold"
title = "Der Preis des Goldes"
description = "Münzen quellen aus der Glut. „Nimm sie", zischt die Esse. „Doch meine Gunst hinterlässt einen Fluch, der den ganzen Run anhält."
choice_labels = Array[String](["80 Gold → -10% Schaden (Run)", "40 Gold → -5% Schaden (Run)", "Finger weg"])
choice_descriptions = Array[String]([
	"Viel Gold, schwerer Fluch auf den ganzen Run.",
	"Weniger Gold, leichterer Fluch.",
	"Die Glut erlischt unberührt.",
])
choice_outcomes = Array[String](["curse:-0.10:80", "curse:-0.05:40", "noop"])

[gd_resource type="Resource" script_class="EventConfig" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/EventConfig.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"steam_vent"
title = "Geheime Dampfleitung"
description = "Heisser Dampf schiesst aus einer geborstenen Leitung."
choice_labels = Array[String](["Reparieren (sicher)", "Anzapfen (riskant)", "Vorbeigehen"])
choice_descriptions = Array[String](["+30 HP, kein Risiko.", "Zufaellig: +Item oder -20 HP.", "Sicher."])
choice_outcomes = Array[String](["damage_gold:-30:0", "random_item_or_damage:20", "noop"])
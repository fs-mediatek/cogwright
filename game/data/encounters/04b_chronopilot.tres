[gd_resource type="Resource" script_class="EncounterConfig" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/EncounterConfig.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"chronopilot"
display_name = "Uhrwerk-Pilot Vesper"
description = "Synchronisierte Zahnräder treiben Pendel zu wahnsinnigen Frequenzen."
